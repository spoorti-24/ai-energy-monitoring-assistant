# Application Settings
APP_NAME="AI Energy Monitoring and Analysis Assistant"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (PostgreSQL)
# Note: Do NOT store real credentials here. Replace placeholders in your local .env file.
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="energy_monitoring"
DB_USER="postgres"
DB_PASSWORD="your_secure_password_here"

# Meter Connector Mode (mock or schneider)
METER_CONNECTOR_TYPE="mock"

# Security / CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
